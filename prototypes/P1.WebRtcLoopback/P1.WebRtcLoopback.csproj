<Project Sdk="Microsoft.NET.Sdk">

  <!-- Protótipo P1 (docs/prototypes/plano.md): libdatachannel via P/Invoke, DTLS-SRTP P2P sem TURN. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NativeBinDir>$(MSBuildThisFileDirectory)..\..\native\vcpkg_installed\x64-windows\bin\</NativeBinDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeBinDir)*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="CheckNativeBinaries" BeforeTargets="Build">
    <Error Condition="!Exists('$(NativeBinDir)datachannel.dll')"
           Text="datachannel.dll não encontrada. Execute: vcpkg install --x-manifest-root=native --x-install-root=native/vcpkg_installed --triplet x64-windows" />
  </Target>

</Project>
