<UserControl
    x:Class="Coconut.App.Views.ParticipantItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Coconut.App.Views">

    <!-- Um participante: iniciais, nome, estado; borda de destaque enquanto fala. -->
    <Border
        x:Name="Card"
        Width="168"
        Height="170"
        Style="{StaticResource CardBorderStyle}"
        BorderThickness="2"
        BorderBrush="{x:Bind local:ParticipantItem.SpeakingBrush(Participant.IsSpeaking), Mode=OneWay}">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <PersonPicture
                Width="56"
                Height="56"
                DisplayName="{x:Bind Participant.DisplayName, Mode=OneWay}" />

            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Participant.DisplayName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <Grid Grid.Row="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Participant.StatusText, Mode=OneWay}" />
                <Button
                    HorizontalAlignment="Right"
                    Padding="4"
                    AutomationProperties.Name="Remover da sala"
                    Command="{x:Bind Participant.KickCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Remover da sala"
                    Visibility="{x:Bind local:ParticipantItem.VisibleIfTrue(Participant.CanBeKicked), Mode=OneWay, FallbackValue=Collapsed}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
            <TextBlock Grid.Row="3" Text="{x:Bind Participant.ConnectionText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Border>
</UserControl>
