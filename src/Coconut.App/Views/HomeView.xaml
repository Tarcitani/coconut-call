<UserControl
    x:Class="Coconut.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Coconut.App.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource ContentMaxWidth}"
            Margin="{StaticResource PagePadding}"
            VerticalAlignment="Center"
            Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Coconut" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Chamadas de voz ponto a ponto, sem contas."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <InfoBar
                Title="Privacidade"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.ShowIpNotice, Mode=OneWay}"
                Message="{x:Bind local:HomeView.IpNotice}"
                CloseButtonCommand="{x:Bind ViewModel.AcknowledgeIpNoticeCommand}"
                Severity="Informational" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind local:Bind.HasText(ViewModel.Error), Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="{StaticResource StackSpacing}">
                    <TextBox
                        AutomationProperties.Name="Seu nome"
                        Header="Seu nome"
                        MaxLength="32"
                        PlaceholderText="Como os outros vão ver você"
                        Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CreateRoomCommand}"
                        Content="Criar sala"
                        Style="{StaticResource AccentButtonStyle}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="ou entre com um convite" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            AutomationProperties.Name="Código ou link do convite"
                            PlaceholderText="Código ou link do convite"
                            Text="{x:Bind ViewModel.InviteInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.JoinRoomCommand}"
                            Content="Entrar" />
                    </Grid>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind local:Bind.VisibleIf(ViewModel.IsBusy), Mode=OneWay}">
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="Conectando aos participantes…" />
                        <HyperlinkButton Command="{x:Bind ViewModel.CancelCommand}" Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander HorizontalAlignment="Stretch" Header="Avançado">
                <TextBox
                    Header="Servidor de sinalização"
                    PlaceholderText="wss://…"
                    Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
