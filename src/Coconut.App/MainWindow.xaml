<Window
    x:Class="Coconut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Coconut.App.Views"
    Title="Coconut">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- A janela só hospeda a página atual; cada área funcional vive na sua view. -->
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="HomeTemplate">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate x:Key="CallTemplate">
                <views:CallView />
            </DataTemplate>
            <views:PageTemplateSelector
                x:Key="PageSelector"
                Home="{StaticResource HomeTemplate}"
                Call="{StaticResource CallTemplate}" />
        </Grid.Resources>

        <ContentControl
            x:Name="PageHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ContentTemplateSelector="{StaticResource PageSelector}" />
    </Grid>
</Window>
