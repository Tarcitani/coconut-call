<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Espaçamento e dimensões compartilhados. Cores e tipografia vêm do Fluent (tema claro/escuro do sistema). -->
    <x:Double x:Key="ContentMaxWidth">440</x:Double>
    <Thickness x:Key="PagePadding">24,24,24,24</Thickness>
    <Thickness x:Key="CardPadding">20,20,20,20</Thickness>
    <x:Double x:Key="StackSpacing">12</x:Double>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
</ResourceDictionary>
