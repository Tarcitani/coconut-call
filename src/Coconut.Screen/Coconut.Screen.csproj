<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ScreenNativeRoot>$(MSBuildThisFileDirectory)..\..\</ScreenNativeRoot>
  </PropertyGroup>
  <Target Name="BuildScreenNative" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ScreenNativeRoot)native\Coconut.Screen\build.ps1&quot; -Configuration $(Configuration)" />
  </Target>
  <ItemGroup>
    <None Include="$(ScreenNativeRoot)artifacts\native-screen\bin\$(Configuration)\Coconut.Screen.Native.dll" Link="Coconut.Screen.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
